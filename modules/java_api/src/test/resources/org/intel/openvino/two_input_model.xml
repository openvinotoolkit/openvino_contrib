<net name="two_input_model" version="11">
    <layers>
        <layer id="0" name="input_a" type="Parameter" version="opset1">
            <data shape="1,3" element_type="f32"/>
            <output>
                <port id="0" precision="FP32" names="input_a">
                    <dim>1</dim>
                    <dim>3</dim>
                </port>
            </output>
        </layer>
        <layer id="1" name="output_a" type="Result" version="opset1">
            <input>
                <port id="0" precision="FP32">
                    <dim>1</dim>
                    <dim>3</dim>
                </port>
            </input>
        </layer>
        <layer id="2" name="input_b" type="Parameter" version="opset1">
            <data shape="1,5" element_type="f32"/>
            <output>
                <port id="0" precision="FP32" names="input_b">
                    <dim>1</dim>
                    <dim>5</dim>
                </port>
            </output>
        </layer>
        <layer id="3" name="output_b" type="Result" version="opset1">
            <input>
                <port id="0" precision="FP32">
                    <dim>1</dim>
                    <dim>5</dim>
                </port>
            </input>
        </layer>
    </layers>
    <edges>
        <edge from-layer="0" from-port="0" to-layer="1" to-port="0"/>
        <edge from-layer="2" from-port="0" to-layer="3" to-port="0"/>
    </edges>
</net>
